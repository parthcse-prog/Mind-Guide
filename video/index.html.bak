// 1. Voice-over Breath-Chunked Script
const SCRIPT = [
  // S0: Identity & Hero Intro
  ["Hello and welcome to Saarthi.ai,", "your personalized AI companion", "for life, personal growth,", "and career mentorship."],
  
  // S1: 3D Virtual Mentors
