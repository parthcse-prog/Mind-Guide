IN(document.querySelector("#sc5-subtext"), W(5, "tests"), 0.6, { transform: "translateY(20px)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 });
IN(document.querySelector("#sc5-rewrite-card"), W(5, "rewrites"), 0.7, { transform: "translateY(30px)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 }, SPRING);

IN(document.querySelector("#sc5-shot-radar"), W(5, "ready"), 0.85,
   { transform: "rotate(4deg) translateX(70px)", opacity: 0 },
   { transform: "rotate(1.8deg) translateX(0px)", opacity: 1 }, EOUT);

IN(document.querySelector("#sc5-shot-score"), W(5, "ats"), 0.8,
   { transform: "rotate(-5deg) translateY(50px)", opacity: 0 },
   { transform: "rotate(-2.5deg) translateY(0px)", opacity: 1 }, SPRING);
PULSE(document.querySelector("#sc5-radar-pulse"), W(5, "radar"));

// SCENE 6 (S6)
IN(document.querySelector("#sc6-eyebrow"), W(6, "finally"), 0.5, { transform: "translateY(-15px)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 });
const sc6Words = split(document.querySelector("#sc6-headline"));
const sc6WordTimes = sc6Words.map((_, i) => W(6, "smart") + i * 0.16);
KIN(sc6Words, sc6WordTimes);

IN(document.querySelector("#sc6-subtext"), W(6, "connects"), 0.6, { transform: "translateY(20px)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 });
IN(document.querySelector("#sc6-match-card"), W(6, "ranked"), 0.7, { transform: "translateY(25px)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 }, SPRING);

IN(document.querySelector("#sc6-shot-job"), W(6, "finally"), 0.85,
   { transform: "rotate(-3.5deg) translateX(80px)", opacity: 0 },
   { transform: "rotate(-1.5deg) translateX(0px)", opacity: 1 }, EOUT);
PULSE(document.querySelector("#sc6-job-pulse"), W(6, "percentage"));
IN(document.querySelector("#sc6-hl-job"), W(6, "percentage"), 0.5, { opacity: 0 }, { opacity: 1 }, SPRING);

// SCENE 7 (S7)
IN(document.querySelector("#sc7-eyebrow"), W(7, "clarity"), 0.5, { transform: "translateY(-15px)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 });
const sc7Words = split(document.querySelector("#sc7-headline"));
const sc7WordTimes = sc7Words.map((_, i) => W(7, "clarity") + i * 0.18);
KIN(sc7Words, sc7WordTimes);

IN(document.querySelector("#sc7-subtext"), W(7, "saarthi"), 0.7, { transform: "translateY(25px)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 });
IN(document.querySelector("#sc7-lockup"), W(7, "complete"), 0.8, { transform: "scale(0.85) translateY(30px)", opacity: 0 }, { transform: "scale(1.0) translateY(0px)", opacity: 1 }, SPRING);

/* =======================================================================
   7. MASTER CLOCK, SEEK CONTROLLER & PREVIEW UI
======================================================================= */

let currentTime = 0;
let isPlaying = false;
let rafId = null;
let lastRafTime = null;

function seek(t) {
  currentTime = Math.max(0, Math.min(END, t));
  const ms = currentTime * 1000;
  for (let i = 0; i < A.length; i++) {
    A[i].currentTime = ms;
  }
  updateUI();
}

window.seek = seek;

function formatTime(s) {
  const m = Math.floor(s / 60);
  const sec = Math.floor(s % 60);
  const tenth = Math.floor((s % 1) * 10);
  return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}.${tenth}`;
}

// 8. Media Player & Sliced Chapter Timeline
const chapters = [
  { name: "Intro", start: 0, end: S(0).end },
  { name: "3D Mentors", start: S(0).end, end: S(1).end },
  { name: "Past Memory", start: S(1).end, end: S(2).end },
  { name: "SWOT Report", start: S(2).end, end: S(3).end },
  { name: "Visual Roadmap", start: S(3).end, end: S(4).end },
  { name: "ATS Analyzer", start: S(4).end, end: S(5).end },
  { name: "Smart Jobs", start: S(5).end, end: S(6).end },
  { name: "Outro Lockup", start: S(6).end, end: END }
];

const sliceTrack = document.querySelector("#slice-track");
const sliceTooltip = document.querySelector("#slice-tooltip");
const sliceTrackContainer = document.querySelector("#slice-track-container");
const sliceElements = [];

// Build slice segments dynamically
chapters.forEach((ch, idx) => {
  const seg = document.createElement("div");
  seg.className = "slice-segment";
  const durationPct = ((ch.end - ch.start) / END) * 100;
  seg.style.width = `${durationPct}%`;
  seg.setAttribute("data-idx", idx);

  const fill = document.createElement("div");
  fill.className = "slice-fill";
  seg.appendChild(fill);

  // Click on a slice to seek
  seg.addEventListener("click", (e) => {
    e.stopPropagation();
    const rect = seg.getBoundingClientRect();
    const clickRatio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
    const targetT = ch.start + clickRatio * (ch.end - ch.start);
    seek(targetT);
  });

  sliceTrack.appendChild(seg);
  sliceElements.push({ seg, fill, ch });
});

// Tooltip on hover
sliceTrackContainer.addEventListener("mousemove", (e) => {
  const rect = sliceTrackContainer.getBoundingClientRect();
  const mouseRatio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
  const hoverT = mouseRatio * END;
  
  let hoverChapter = chapters[0];
  for (const c of chapters) {
    if (hoverT >= c.start && hoverT <= c.end) {
      hoverChapter = c;
      break;
    }
  }

  sliceTooltip.textContent = `${hoverChapter.name} · ${formatTime(hoverT)}`;
  sliceTooltip.style.left = `${e.clientX}px`;
  sliceTooltip.style.opacity = "1";
});

sliceTrackContainer.addEventListener("mouseleave", () => {
  sliceTooltip.style.opacity = "0";
});

// Drag scrub across slices
let isDraggingSlice = false;
sliceTrackContainer.addEventListener("mousedown", (e) => {
  isDraggingSlice = true;
  handleSliceScrub(e);
});

window.addEventListener("mousemove", (e) => {
  if (isDraggingSlice) handleSliceScrub(e);
});

window.addEventListener("mouseup", () => {
  isDraggingSlice = false;
});

function handleSliceScrub(e) {
  const rect = sliceTrackContainer.getBoundingClientRect();
  const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
  seek(ratio * END);
}

// Media Controls Elements
const playBtn = document.querySelector("#play-btn");
const playIcon = document.querySelector("#play-icon");
const restartBtn = document.querySelector("#restart-btn");
const fullscreenBtn = document.querySelector("#fullscreen-btn");
const fsEnterIcon = document.querySelector("#fs-enter-icon");
const fsExitIcon = document.querySelector("#fs-exit-icon");
const currentTimeText = document.querySelector("#current-time-text");
const totalTimeText = document.querySelector("#total-time-text");
const chapterNameText = document.querySelector("#chapter-name");

if (totalTimeText) totalTimeText.textContent = formatTime(END);

function updateUI() {
  if (currentTimeText) currentTimeText.textContent = formatTime(currentTime);

  let currentChapter = chapters[0];
  sliceElements.forEach(({ fill, ch }) => {
    if (currentTime <= ch.start) {
      fill.style.width = "0%";
    } else if (currentTime >= ch.end) {
      fill.style.width = "100%";
    } else {
      currentChapter = ch;
      const pct = ((currentTime - ch.start) / (ch.end - ch.start)) * 100;
      fill.style.width = `${pct}%`;
    }
  });

  if (currentTime >= chapters[chapters.length - 1].start) {
    currentChapter = chapters[chapters.length - 1];
  }
  if (chapterNameText) chapterNameText.textContent = currentChapter.name;
}

function play() {
  if (currentTime >= END) seek(0);
  isPlaying = true;
  lastRafTime = performance.now();
  if (playIcon) {
    playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect>';
  }
  loop();
}

function pause() {
  isPlaying = false;
  if (rafId) cancelAnimationFrame(rafId);
  if (playIcon) {
    playIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"></polygon>';
  }
}

function togglePlay() {
  if (isPlaying) pause();
  else play();
}

function loop() {
  if (!isPlaying) return;
  const now = performance.now();
  const dt = (now - lastRafTime) / 1000;
  lastRafTime = now;
  seek(currentTime + dt);
  if (currentTime >= END) {
    pause();
    seek(END);
    return;
  }
  rafId = requestAnimationFrame(loop);
}

playBtn.addEventListener("click", togglePlay);

restartBtn.addEventListener("click", () => {
  seek(0);
  play();
});

// Fullscreen toggle
function toggleFullscreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen().catch(() => {});
  } else {
    document.exitFullscreen().catch(() => {});
  }
}

fullscreenBtn.addEventListener("click", toggleFullscreen);

document.addEventListener("fullscreenchange", () => {
  const isFs = !!document.fullscreenElement;
  if (fsEnterIcon) fsEnterIcon.style.display = isFs ? "none" : "block";
  if (fsExitIcon) fsExitIcon.style.display = isFs ? "block" : "none";
});

// Keyboard controls
window.addEventListener("keydown", (e) => {
  if (e.target.tagName === "INPUT") return;
  if (e.code === "Space") {
    e.preventDefault();
    togglePlay();
  } else if (e.code === "ArrowLeft") {
    e.preventDefault();
    pause();
    seek(currentTime - (e.shiftKey ? 5 : 1));
  } else if (e.code === "ArrowRight") {
    e.preventDefault();
    pause();
    seek(currentTime + (e.shiftKey ? 5 : 1));
  } else if (e.code === "Home") {
    e.preventDefault();
    pause();
    seek(0);
  } else if (e.code === "KeyF") {
    e.preventDefault();
    toggleFullscreen();
  }
});

// Viewport scaler for #stage
function resizeStage() {
  const stage = document.querySelector("#stage");
  const isRender = window.location.hash.includes("render");
  const bottomBarHeight = isRender ? 0 : 66;
  const vw = window.innerWidth;
  const vh = window.innerHeight - bottomBarHeight;
  const scale = Math.min(vw / 1920, vh / 1080);
  stage.style.transform = `scale(${scale})`;
}

window.addEventListener("resize", resizeStage);
resizeStage();

// Render Mode detection: #render hides controls and disables autoplay
const isRenderMode = window.location.hash.includes("render");
if (isRenderMode) {
  document.body.classList.add("render-mode");
  const player = document.querySelector("#sticky-player");
  if (player) player.classList.add("hidden");
}

// Drag & Drop image preview onto any .shot slot
document.querySelectorAll(".shot").forEach(slot => {
  slot.addEventListener("dragover", (e) => {
    e.preventDefault();
    slot.style.outline = "3px dashed var(--accent-light)";
  });
  slot.addEventListener("dragleave", () => {
    slot.style.outline = "none";
  });
  slot.addEventListener("drop", (e) => {
    e.preventDefault();
    slot.style.outline = "none";
    const file = e.dataTransfer.files[0];
    if (file && file.type.startsWith("image/")) {
      const reader = new FileReader();
      reader.onload = (re) => {
        const img = slot.querySelector("img");
        if (img) img.src = re.target.result;
      };
      reader.readAsDataURL(file);
    }
  });
});

// Initial seek to 0
seek(0);
</script>
</body>
</html>
