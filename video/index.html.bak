<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Saarthi.ai - Product Demo Video</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f8fafc;
      --accent: #0f766e;
      --accent-light: #14b8a6;
      --accent-dark: #115e59;
      --hi: #0284c7;
      --hi-light: #38bdf8;
      --sec: #0f172a;
      --warm: #f43f5e;
      --amber: #f59e0b;
      --emerald: #10b981;
      --muted: #64748b;
      --border: rgba(226, 232, 240, 0.9);
      
      --card-bg: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.72) 100%);
      --card-border: 1.5px solid rgba(255, 255, 255, 0.95);
      --card-shadow: 0 24px 60px -12px rgba(15, 23, 42, 0.12), 0 8px 24px -8px rgba(15, 118, 110, 0.08);
      --card-shadow-heavy: 0 32px 80px -16px rgba(15, 23, 42, 0.2), 0 12px 32px -8px rgba(15, 118, 110, 0.12);
      --radius: 28px;
      
      --g-a: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
      --g-h: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
      --g-s: linear-gradient(135deg, #0f172a 0%, #334155 100%);
      --g-p: linear-gradient(135deg, #0f766e 0%, #0284c7 100%);
      --g-warm: linear-gradient(135deg, #f43f5e 0%, #fb7185 100%);
      --g-amber: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
      --g-emerald: linear-gradient(135deg, #059669 0%, #10b981 100%);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }

    body {
      background-color: #0b0f19;
      color: var(--sec);
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      width: 100vw;
    }

    #stage-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      box-sizing: border-box;
      padding-bottom: 66px;
    }

    body.render-mode #stage-container {
      padding-bottom: 0px !important;
    }

    #stage {
      position: absolute;
      width: 1920px;
      height: 1080px;
      background: var(--bg);
      overflow: hidden;
      transform-origin: center center;
      box-shadow: 0 0 100px rgba(0, 0, 0, 0.6);
    }

    /* Fixed background with masked grid */
    #bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-color: #f8fafc;
      background-image:
        radial-gradient(circle at 10% 10%, rgba(15, 118, 110, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 90% 90%, rgba(2, 132, 199, 0.05) 0%, transparent 40%),
        linear-gradient(to right, rgba(15, 118, 110, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(15, 118, 110, 0.04) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 80px 80px, 80px 80px;
      mask-image: radial-gradient(circle at 50% 50%, black 35%, rgba(0,0,0,0.6) 70%, transparent 92%);
      -webkit-mask-image: radial-gradient(circle at 50% 50%, black 35%, rgba(0,0,0,0.6) 70%, transparent 92%);
    }

    /* Camera root */
    #camera {
      position: absolute;
      inset: 0;
      transform-origin: 960px 540px;
      will-change: transform;
      z-index: 10;
    }

    #cam-inner {
      position: absolute;
      inset: 0;
      transform-origin: 960px 540px;
    }

    /* Parallax Floating Accents Layer (1.4x camera) */
    #fg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 25;
      transform-origin: 960px 540px;
    }

    .fg-node {
      position: absolute;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(15, 118, 110, 0.25) 0%, rgba(15, 118, 110, 0) 70%);
      filter: blur(8px);
    }

    .fg-chip {
      position: absolute;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 10px 25px rgba(15, 23, 42, 0.05);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 6px 14px;
      color: var(--accent);
    }

    /* Fast move camera motion blur simulator */
    #camblur {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 30;
      opacity: 0;
      background: transparent;
      backdrop-filter: blur(0px);
    }

    /* Scene Hierarchy: scene (IN) -> out (OUT) -> ct (CONTENT) */
    section.scene {
      position: absolute;
      inset: 0;
      width: 1920px;
      height: 1080px;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      will-change: transform, opacity;
    }

    .out {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      will-change: transform, opacity;
    }

    .ct {
      position: relative;
      width: 1520px;
      height: 820px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 0 auto;
    }

    /* Cards and Glass Panels */
    .card {
      background: var(--card-bg);
      border: var(--card-border);
      box-shadow: var(--card-shadow);
      border-radius: var(--radius);
      position: relative;
      overflow: hidden;
    }

    .card.heavy-shadow {
      box-shadow: var(--card-shadow-heavy);
    }

    /* Screenshots & Bare Panels */
    .shot {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      background: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.16), 0 8px 24px -8px rgba(15, 23, 42, 0.08);
      transform-origin: center center;
    }

    .shot img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .shot.device-frame {
      border: 10px solid #ffffff;
      box-shadow: 0 35px 80px -20px rgba(15, 23, 42, 0.22), 0 15px 35px -10px rgba(15, 118, 110, 0.15);
      border-radius: 24px;
    }

    /* Pulse Rings and Highlights */
    .pulse-ring {
      position: absolute;
      border-radius: 50%;
      border: 2px solid var(--accent-light);
      pointer-events: none;
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.6);
      will-change: transform, opacity;
    }

    .hl-box {
      position: absolute;
      border: 2px solid var(--amber);
      background: rgba(245, 158, 11, 0.12);
      border-radius: 12px;
      pointer-events: none;
      opacity: 0;
      will-change: transform, opacity;
    }

    /* Typography & Hierarchy */
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 7px 16px;
      border-radius: 999px;
      background: rgba(15, 118, 110, 0.08);
      border: 1px solid rgba(15, 118, 110, 0.2);
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .eyebrow-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 10px var(--accent-light);
    }

    .h1 {
      font-size: 72px;
      line-height: 1.08;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--sec);
      margin-bottom: 20px;
    }

    .h2 {
      font-size: 54px;
      line-height: 1.14;
      font-weight: 800;
      letter-spacing: -0.025em;
      color: var(--sec);
      margin-bottom: 18px;
    }

    .h3 {
      font-size: 38px;
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: -0.015em;
      color: var(--sec);
      margin-bottom: 14px;
    }

    .lead {
      font-size: 22px;
      line-height: 1.45;
      font-weight: 400;
      color: var(--muted);
      max-width: 640px;
    }

    .gradient-text {
      background: var(--g-p);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .word-wrap {
      display: inline-block;
      overflow: hidden;
      vertical-align: top;
      margin-right: 0.28em;
    }

    .word {
      display: inline-block;
      will-change: transform, opacity;
    }

    /* Pill Badges */
    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 20px;
      border-radius: 16px;
      background: #ffffff;
      border: 1px solid rgba(226, 232, 240, 0.9);
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
      font-size: 16px;
      font-weight: 600;
      color: var(--sec);
    }

    .badge-pill.active {
      background: var(--g-a);
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 12px 28px rgba(15, 118, 110, 0.25);
    }

    /* Transition Overlays */
    .trans-overlay {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 40;
    }

    /* Sticky Full-Width Media Player Bottom Bar */
    #sticky-player {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100vw;
      background: rgba(11, 15, 25, 0.94);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.5);
      z-index: 1000;
      display: flex;
      flex-direction: column;
      user-select: none;
    }

    #sticky-player.hidden {
      display: none !important;
    }

    /* Sliced Progress Bar */
    #slice-track-container {
      position: relative;
      width: 100%;
      height: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      padding: 0 16px;
      box-sizing: border-box;
    }

    #slice-track {
      width: 100%;
      height: 5px;
      display: flex;
      gap: 3px;
      transition: height 0.15s ease;
      align-items: center;
    }

    #slice-track-container:hover #slice-track {
      height: 9px;
    }

    .slice-segment {
      position: relative;
      height: 100%;
      background: rgba(255, 255, 255, 0.16);
      border-radius: 3px;
      overflow: hidden;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .slice-segment:hover {
      background: rgba(255, 255, 255, 0.28);
    }

    .slice-fill {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
      box-shadow: 0 0 12px rgba(20, 184, 166, 0.6);
      border-radius: 3px;
      pointer-events: none;
    }

    #slice-tooltip {
      position: absolute;
      bottom: 24px;
      transform: translateX(-50%);
      background: rgba(15, 23, 42, 0.96);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      pointer-events: none;
      white-space: nowrap;
      opacity: 0;
      transition: opacity 0.15s ease;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.5);
      font-family: 'JetBrains Mono', monospace;
      z-index: 1010;
    }

    /* Player Controls Row */
    #player-controls-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 52px;
      padding: 0 20px;
      color: #ffffff;
    }

    .player-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .player-btn {
      background: transparent;
      border: none;
      color: #cbd5e1;
      width: 36px;
      height: 36px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .player-btn:hover {
      background: rgba(255, 255, 255, 0.12);
      color: #ffffff;
    }

    .player-btn:active {
      transform: scale(0.92);
    }

    .player-time {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      color: #94a3b8;
      display: flex;
      align-items: center;
      gap: 6px;
      margin-left: 6px;
    }

    #current-time-text {
      color: #f8fafc;
      font-weight: 700;
    }

    .time-sep {
      color: #475569;
    }

    .chapter-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 999px;
      background: rgba(15, 118, 110, 0.2);
      border: 1px solid rgba(20, 184, 166, 0.35);
      color: #2dd4bf;
      font-size: 12px;
      font-weight: 700;
      margin-left: 12px;
    }

    .chapter-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #14b8a6;
      box-shadow: 0 0 6px #14b8a6;
    }

    .player-center {
      display: flex;
      align-items: center;
      font-size: 13px;
      font-weight: 600;
      color: #64748b;
      letter-spacing: 0.04em;
    }

    .player-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }
  </style>
</head>
<body>

<div id="stage-container">
  <div id="stage">
    <!-- Static masked background grid -->
    <div id="bg"></div>

    <!-- Parallax floating elements (1.15x camera) -->
    <div id="fg">
      <div class="fg-node" style="width: 260px; height: 260px; top: 120px; left: 160px;"></div>
      <div class="fg-node" style="width: 300px; height: 300px; bottom: 100px; right: 180px; background: radial-gradient(circle, rgba(2, 132, 199, 0.18) 0%, transparent 70%);"></div>
      <div class="fg-chip" style="top: 60px; right: 220px;">24/7 MIET Gateway</div>
      <div class="fg-chip" style="bottom: 90px; left: 240px;">100% Confidential</div>
    </div>

    <!-- Motion blur simulator during fast transitions -->
    <div id="camblur"></div>

    <!-- Camera wrapper -->
    <div id="camera">
      <div id="cam-inner">

        <!-- ==========================================
             SCENE 0: IDENTITY & HERO INTRO (S0)
        =========================================== -->
        <section class="scene" id="sc0">
          <div class="out" id="out0">
            <div class="ct">
              <!-- Left: Typography & Logo -->
              <div style="flex: 1.05; max-width: 720px; z-index: 2;">
                <div class="eyebrow" id="sc0-eyebrow">
                  <span class="eyebrow-dot"></span>
                  <span>MIET Jammu · Safe & Confidential Companion</span>
                </div>

                <!-- Animated SVG Logo -->
                <div id="sc0-logo-box" style="display: flex; align-items: center; gap: 20px; margin-bottom: 24px;">
                  <svg width="68" height="68" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="50" cy="50" r="44" stroke="#0f766e" stroke-width="3" stroke-dasharray="1" stroke-dashoffset="1" pathLength="1" id="sc0-svg-circle" />
                    <!-- Brain neural paths -->
                    <path d="M50 22 C34 22 24 34 24 48 C24 60 32 70 42 74 L42 82 L58 82 L58 74 C68 70 76 60 76 48 C76 34 66 22 50 22 Z" 
                          stroke="#14b8a6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
                          stroke-dasharray="1" stroke-dashoffset="1" pathLength="1" id="sc0-svg-brain" />
                    <circle cx="50" cy="40" r="5" fill="#0f766e" id="sc0-svg-n1" />
                    <circle cx="38" cy="52" r="4" fill="#0284c7" id="sc0-svg-n2" />
                    <circle cx="62" cy="52" r="4" fill="#0284c7" id="sc0-svg-n3" />
                    <path d="M50 40 L38 52 M50 40 L62 52 M38 52 L62 52" stroke="#0f766e" stroke-width="2" stroke-linecap="round"
                          stroke-dasharray="1" stroke-dashoffset="1" pathLength="1" id="sc0-svg-synapses" />
                  </svg>
                  <div>
                    <h2 style="font-size: 32px; font-weight: 800; letter-spacing: -0.02em; color: var(--sec); line-height: 1;">Saarthi.ai</h2>
                    <p style="font-size: 13px; font-weight: 600; color: var(--accent); letter-spacing: 0.08em; text-transform: uppercase; margin-top: 4px;">Mind-Guide Platform</p>
                  </div>
                </div>

                <div class="h1" id="sc0-headline">
                  Welcome to <span class="gradient-text">Saarthi.ai</span>, your personal guide.
                </div>

                <p class="lead" id="sc0-subtext" style="margin-bottom: 28px;">
                  Your personalized AI companion for life choices, personal growth, and career mentorship.
                </p>

                <!-- 3 Pillars -->
                <div id="sc0-pillars" style="display: flex; gap: 12px; flex-wrap: wrap;">
                  <div class="badge-pill active">
                    <span style="font-size: 18px;">🌱</span>
                    <span>Life Choices</span>
                  </div>
                  <div class="badge-pill">
                    <span style="font-size: 18px;">🧠</span>
                    <span>Personal Growth</span>
                  </div>
                  <div class="badge-pill">
                    <span style="font-size: 18px;">🚀</span>
                    <span>Career Mentorship</span>
                  </div>
                </div>
              </div>

              <!-- Right: Hero Screenshot device bleeding slightly -->
              <div style="flex: 0.95; position: relative; display: flex; justify-content: flex-end;">
                <div class="shot device-frame" id="sc0-hero-shot" style="width: 740px; height: 460px; transform: rotate(-2deg);">
                  <img src="shots/Saarthi.png" alt="Saarthi Hero Interface">
                  <div class="pulse-ring" id="sc0-hero-ring" style="width: 140px; height: 140px; top: 48%; left: 32%;"></div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ==========================================
             SCENE 1: 3D VIRTUAL MENTORS (S1)
        =========================================== -->
        <section class="scene" id="sc1">
          <div class="out" id="out1">
            <div class="ct">
              <!-- Left Column: Narrative -->
              <div style="flex: 1; max-width: 680px; z-index: 2;">
                <div class="eyebrow" id="sc1-eyebrow">
                  <span class="eyebrow-dot"></span>
                  <span>Empathetic Intelligence · 24/7 Availability</span>
                </div>

                <div class="h2" id="sc1-headline">
                  A Safe, Judgment-Free Space to <span class="gradient-text">Converse &amp; Grow</span>.
                </div>

                <p class="lead" id="sc1-subtext" style="margin-bottom: 26px;">
                  Whenever you need guidance, specialized 3D virtual mentors listen, speak, and adapt to your unique journey.
                </p>

                <!-- Highlights feature list -->
                <div id="sc1-features" style="display: flex; flex-direction: column; gap: 12px;">
                  <div class="card" style="padding: 14px 20px; display: flex; align-items: center; gap: 14px; border-radius: 16px;">
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(15, 118, 110, 0.12); display: flex; align-items: center; justify-content: center; font-size: 20px; color: var(--accent);">🎙️</div>
                    <div>
                      <h4 style="font-size: 15px; font-weight: 700; color: var(--sec);">Real-Time Voice &amp; Lip Sync</h4>
                      <p style="font-size: 12px; color: var(--muted);">Low-latency neural Kokoro TTS audio with Web Audio API frequency analysis.</p>
                    </div>
                  </div>

                  <div class="card" style="padding: 14px 20px; display: flex; align-items: center; gap: 14px; border-radius: 16px;">
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(2, 132, 199, 0.12); display: flex; align-items: center; justify-content: center; font-size: 20px; color: var(--hi);">🛡️</div>
                    <div>
                      <h4 style="font-size: 15px; font-weight: 700; color: var(--sec);">Natural Resting 3D Posture</h4>
                      <p style="font-size: 12px; color: var(--muted);">Steady forward gaze with empathetic gestures tuned for student comfort.</p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Right Column: Staggered Tilted Screenshots of 3D Mentors -->
              <div style="flex: 1.1; position: relative; height: 580px;">
                <!-- Back card -->
                <div class="shot bare" id="sc1-shot-back" style="position: absolute; width: 640px; height: 370px; top: 20px; right: 10px; transform: rotate(2deg);">
                  <img src="shots/Agent 2.png" alt="3D Counselor Interactive Chat">
                </div>

                <!-- Front hero card -->
                <div class="shot device-frame" id="sc1-shot-front" style="position: absolute; width: 670px; height: 390px; bottom: 30px; right: 50px; transform: rotate(-1.5deg); z-index: 3;">
                  <img src="shots/Agent.png" alt="Dr. Alex 3D Mentor">
                  <!-- Audio wave pulse ring on the mentor's microphone -->
                  <div class="pulse-ring" id="sc1-wave-ring" style="width: 140px; height: 140px; top: 52%; left: 42%;"></div>
                  <div class="hl-box" id="sc1-hl-box" style="top: 38%; left: 30%; width: 220px; height: 160px;"></div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ==========================================
             SCENE 2: COUNSELOR DOMAINS & MEMORY (S2)
        =========================================== -->
        <section class="scene" id="sc2">
          <div class="out" id="out2">
            <div class="ct">
              <!-- Left Column: Counseling Domains and Session Continuity -->
              <div style="flex: 0.95; max-width: 660px; z-index: 2;">
                <div class="eyebrow" id="sc2-eyebrow">
                  <span class="eyebrow-dot"></span>
                  <span>Four Dedicated Personas · Session Continuity</span>
                </div>

                <div class="h2" id="sc2-headline">
                  Mentors Who <span class="gradient-text">Remember</span> Past Sessions.
                </div>

                <p class="lead" id="sc2-subtext" style="margin-bottom: 24px;">
                  Covering emotional well-being, personal confidence, relationships, and career direction—continue right where you left off.
                </p>

                <!-- Floating Session Memory Card -->
