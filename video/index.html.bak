IN(document.querySelector("#sc2-subtext"), W(2, "confidence"), 0.6, { transform: "translateY(20px)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 });
IN(document.querySelector("#sc2-memory-card"), W(2, "remember"), 0.7, { transform: "translateX(-40px)", opacity: 0 }, { transform: "translateX(0)", opacity: 1 }, SPRING);
IN(document.querySelector("#sc2-domains"), W(2, "direction"), 0.6, { transform: "translateY(20px)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 });

IN(document.querySelector("#sc2-shot-counselors"), W(2, "covering"), 0.85,
   { transform: "rotate(4deg) translateX(90px)", opacity: 0 },
