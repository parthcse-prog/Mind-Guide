  // S4: Visual Roadmap & Competency Badges
  ["To turn insights into real progress,", "the platform creates an interactive Visual Roadmap", "with day-wise milestones and curated resources,", "mapping your completed goals to your Profile", "with earned competency badges."],
  
  // S5: ATS Resume Analyzer & Radar Chart
  ["When you are ready to take your career forward,", "our ATS Resume Analyzer tests your resume against any target role,", "delivering a visual competency radar chart,", "formatting audits,", "and high-impact bullet point rewrites."],
  
  // S6: Smart Job Board
  ["Finally, the Smart Job Board", "connects your verified skills directly with live career opportunities,", "ranked by a personalized match percentage."],
  
  // S7: Payoff & Closing Lockup
  ["From personal clarity to professional placement,", "Saarthi.ai is your complete guide", "for every step of your journey."]
];

const VO = {}; // Retiming table for future recorded VO timings {0:[start,end]}
const PACE = { lead: 1.0, perWord: 0.34, chunkGap: 0.18, sentGap: 0.6, outro: 2.8 };
const MS = 1.0; // Snappy motion speed factor

// 2. Timeline and Word-Time Calculator
let cursor = PACE.lead;
const sTimings = [];
const allWords = [];

SCRIPT.forEach((chunks, sIdx) => {
  const sStart = cursor;
  const wordsInSent = [];
  chunks.forEach((chunk, cIdx) => {
    const rawWords = chunk.trim().split(/\s+/).filter(Boolean);
    const chunkStart = cursor;
    rawWords.forEach((rw, wIdx) => {
      const clean = rw.toLowerCase().replace(/[^a-z0-9]/g, '');
      const wordT = chunkStart + wIdx * PACE.perWord;
      const wObj = { s: sIdx, c: cIdx, raw: rw, clean, t: wordT };
      wordsInSent.push(wObj);
      allWords.push(wObj);
    });
    cursor = chunkStart + rawWords.length * PACE.perWord;
    if (cIdx < chunks.length - 1) cursor += PACE.chunkGap;
  });
  const sEnd = cursor;
  sTimings.push({ s: sIdx, start: sStart, end: sEnd, words: wordsInSent });
  cursor += PACE.sentGap;
});

const END = cursor - PACE.sentGap + PACE.outro;
window.DURATION = END;

function S(i) {
  if (i < 0 || i >= sTimings.length) throw new Error("Sentence out of bounds: " + i);
  return sTimings[i];
}

function W(sIdx, prefix, nth = 1) {
  const s = S(sIdx);
  const target = prefix.toLowerCase();
  let count = 0;
  for (const w of s.words) {
    if (w.clean.startsWith(target)) {
      count++;
      if (count === nth) return w.t;
    }
  }
  console.warn("W(): word not found:", sIdx, prefix, nth);
  return s.start;
}

// 3. Animation Engine (A[] list, WAAPI driver)
const A = [];

const EIO    = "cubic-bezier(0.65, 0, 0.35, 1)";
const EOUT   = "cubic-bezier(0.16, 1, 0.3, 1)";
const EIN    = "cubic-bezier(0.7, 0, 0.84, 0)";
const SPRING = "cubic-bezier(0.34, 1.56, 0.64, 1)";
const SINE   = "cubic-bezier(0.37, 0, 0.63, 1)";
const LIN    = "linear";

function K(el, keyframeEntries) {
  if (!el) return null;
  // keyframeEntries: [ [timeInSec, {props}, easing], ... ]
  // Ensure sorted by time
  const sorted = [...keyframeEntries].sort((a, b) => a[0] - b[0]);
  
  // Normalize times to offsets [0..1]
  const keyframes = [];
  
  // If first entry > 0, hold initial props from 0
  if (sorted[0][0] > 0) {
    keyframes.push({
      offset: 0,
      ...sorted[0][1]
    });
  }

  sorted.forEach(([t, props, easing]) => {
    const rawOffset = t / END;
    const offset = Math.max(0, Math.min(1, rawOffset));
    const kf = { offset, ...props };
    if (easing) kf.easing = easing;
    keyframes.push(kf);
  });

  // If last entry < 1, hold final props to 1
  if (sorted[sorted.length - 1][0] < END) {
    keyframes.push({
      offset: 1,
      ...sorted[sorted.length - 1][1]
    });
  }

  const anim = el.animate(keyframes, {
    duration: END * 1000,
    fill: "both",
    iterations: 1
  });
  anim.pause();
  A.push(anim);
  return anim;
}

function IN(el, t, dur, fromProps, toProps, easing = EOUT) {
  return K(el, [
    [t, fromProps],
    [t + dur * MS, toProps, easing]
  ]);
}

function WIN(el, tIn, durIn, tOut, durOut, inProps, midProps, outProps, easing = EOUT) {
  return K(el, [
    [tIn, inProps],
    [tIn + durIn * MS, midProps, easing],
    [tOut, midProps],
    [tOut + durOut * MS, outProps, EIN]
  ]);
}

function FADE(el, t0, t1, easing = SINE) {
  return K(el, [
    [t0, { opacity: 0 }],
    [t1, { opacity: 1 }, easing]
  ]);
}

function DRAW(el, t0, t1, easing = EIO) {
  return K(el, [
    [t0, { strokeDashoffset: 1 }],
    [t1, { strokeDashoffset: 0 }, easing]
  ]);
}

function SWEEP(el, t0, t1, easing = EOUT) {
  return K(el, [
    [t0, { clipPath: "inset(0 100% 0 0 round 16px)", opacity: 0 }],
    [t0 + 0.1, { opacity: 1 }],
    [t1, { clipPath: "inset(0 0% 0 0 round 16px)", opacity: 1 }, easing]
  ]);
}

function PULSE(el, t0, dur = 1.2, easing = EOUT) {
  return K(el, [
    [t0, { transform: "translate(-50%, -50%) scale(0.6)", opacity: 0 }],
    [t0 + 0.1, { opacity: 0.9 }],
    [t0 + dur, { transform: "translate(-50%, -50%) scale(1.6)", opacity: 0 }, easing]
  ]);
}

function split(el) {
  if (!el) return [];
  const text = el.innerText.trim();
  const words = text.split(/\s+/);
  el.innerHTML = words.map(w => `<span class="word-wrap"><span class="word">${w}</span></span>`).join(" ");
  return Array.from(el.querySelectorAll(".word"));
}

function KIN(wordEls, times, dur = 0.5, easing = EOUT) {
  wordEls.forEach((wEl, i) => {
    const t = times[i] !== undefined ? times[i] : times[times.length - 1] + i * 0.1;
    K(wEl, [
      [t, { transform: "translateY(100%)", opacity: 0 }],
      [t + dur * MS, { transform: "translateY(0%)", opacity: 1 }, easing]
    ]);
  });
}

// 4. Transitions Table T{} and Scene Orchestration
const T = {
  t0_1: S(0).end,
  t1_2: S(1).end,
  t2_3: S(2).end,
  t3_4: S(3).end,
  t4_5: S(4).end,
  t5_6: S(5).end,
  t6_7: S(6).end
};

// Setup In / Out animations for scenes
// In animates section.scene; Out animates .out
const scenes = [
  { sc: "#sc0", out: "#out0", inT: 0, outT: T.t0_1, trans: "ring" },
  { sc: "#sc1", out: "#out1", inT: T.t0_1, outT: T.t1_2, trans: "push" },
  { sc: "#sc2", out: "#out2", inT: T.t1_2, outT: T.t2_3, trans: "wipeX" },
  { sc: "#sc3", out: "#out3", inT: T.t2_3, outT: T.t3_4, trans: "zoom" },
  { sc: "#sc4", out: "#out4", inT: T.t3_4, outT: T.t4_5, trans: "zoomPast" },
  { sc: "#sc5", out: "#out5", inT: T.t4_5, outT: T.t5_6, trans: "morph" },
  { sc: "#sc6", out: "#out6", inT: T.t5_6, outT: T.t6_7, trans: "blur" },
  { sc: "#sc7", out: "#out7", inT: T.t6_7, outT: END, trans: "hold" }
];

scenes.forEach((item, idx) => {
  const scEl = document.querySelector(item.sc);
  const outEl = document.querySelector(item.out);
  const D = 0.85; // transition duration

  // In transition on scEl
  if (idx === 0) {
    // Opening: fade in directly, hide completely after transition out finishes
    K(scEl, [
      [0, { opacity: 1, pointerEvents: "auto" }],
      [item.outT + D, { opacity: 1 }],
      [item.outT + D + 0.05, { opacity: 0, pointerEvents: "none" }],
      [END, { opacity: 0, pointerEvents: "none" }]
    ]);
  } else {
    const t = item.inT;
    const inKeyframes = [];
    inKeyframes.push([0, { opacity: 0, pointerEvents: "none" }]);
    inKeyframes.push([Math.max(0, t - 0.06), { opacity: 0, pointerEvents: "none" }]);
    
    switch(item.trans) {
      case "push":
        inKeyframes.push([t - 0.05, { transform: "translateX(100%)", opacity: 0 }]);
        inKeyframes.push([t + D, { transform: "translateX(0%)", opacity: 1, pointerEvents: "auto" }, EOUT]);
        break;
      case "zoom":
        inKeyframes.push([t - 0.05, { transform: "scale(0.8)", opacity: 0 }]);
        inKeyframes.push([t + D, { transform: "scale(1.0)", opacity: 1, pointerEvents: "auto" }, EOUT]);
        break;
      case "zoomPast":
        inKeyframes.push([t - 0.05, { transform: "scale(1.3)", opacity: 0 }]);
        inKeyframes.push([t + D, { transform: "scale(1.0)", opacity: 1, pointerEvents: "auto" }, EOUT]);
        break;
      case "wipeX":
        inKeyframes.push([t - 0.05, { clipPath: "inset(0 0 0 100%)", opacity: 1 }]);
        inKeyframes.push([t + D, { clipPath: "inset(0 0 0 0%)", opacity: 1, pointerEvents: "auto" }, EIO]);
        break;
      case "morph":
      case "blur":
      case "ring":
      default:
        inKeyframes.push([t - 0.05, { opacity: 0, transform: "scale(0.96)" }]);
        inKeyframes.push([t + D, { opacity: 1, transform: "scale(1.0)", pointerEvents: "auto" }, EOUT]);
        break;
    }

    if (idx < scenes.length - 1) {
      inKeyframes.push([item.outT + D, { opacity: 1 }]);
      inKeyframes.push([item.outT + D + 0.05, { opacity: 0, pointerEvents: "none" }]);
      inKeyframes.push([END, { opacity: 0, pointerEvents: "none" }]);
    }
    K(scEl, inKeyframes);
  }

  // Out transition on outEl
  if (idx < scenes.length - 1) {
    const t = item.outT;
    switch(item.trans) {
      case "push":
        K(outEl, [
          [t, { transform: "translateX(0%)", opacity: 1 }],
          [t + D, { transform: "translateX(-40%)", opacity: 0 }, EIN]
        ]);
        break;
      case "zoom":
        K(outEl, [
          [t, { transform: "scale(1.0)", opacity: 1 }],
          [t + D, { transform: "scale(1.25)", opacity: 0 }, EIN]
        ]);
        break;
      case "zoomPast":
        K(outEl, [
          [t, { transform: "scale(1.0)", opacity: 1 }],
          [t + D, { transform: "scale(0.75)", opacity: 0 }, EIN]
        ]);
        break;
      case "wipeX":
        K(outEl, [
          [t, { opacity: 1 }],
          [t + D, { opacity: 0 }, SINE]
        ]);
        break;
      case "ring":
      case "morph":
      case "blur":
      default:
        K(outEl, [
          [t, { opacity: 1, transform: "scale(1.0)" }],
          [t + D, { opacity: 0, transform: "scale(1.04)" }, EIN]
        ]);
        break;
    }
  }
});

// 5. Camera System & Anti-Tremor Rules
function P(x, y, scale = 1.0, rot = 0) {
  return { x, y, scale, rot };
}

const rawCamTrack = [
  // Scene 0: Welcome
  [0, P(960, 540, 0.98, -1.5), EIO],
  [W(0, "welcome"), P(960, 540, 1.0, 0), EOUT],
  [W(0, "companion"), P(975, 540, 1.04, 0), EIO],
  
  // Scene 1: 3D Mentors
  [T.t0_1, P(960, 540, 1.0, 0), EIO],
  [W(1, "mentors"), P(975, 535, 1.05, 0), EOUT],
  [W(1, "listen"), P(980, 535, 1.06, 0), EIO],
  
  // Scene 2: Domains & Memory
  [T.t1_2, P(960, 540, 1.0, 0), EIO],
  [W(2, "covering"), P(975, 540, 1.04, 0), EOUT],
  [W(2, "remember"), P(950, 538, 1.05, 0), EIO],
  
  // Scene 3: Guidance Report & SWOT
  [T.t2_3, P(960, 540, 1.0, 0), EIO],
  [W(3, "compiles"), P(970, 538, 1.05, 0), EOUT],
  [W(3, "pdf"), P(955, 542, 1.06, 0), EIO],
  
  // Scene 4: Visual Roadmap & Badges
  [T.t3_4, P(960, 540, 1.0, 0), EIO],
  [W(4, "visual"), P(950, 538, 1.05, 0), EOUT],
  [W(4, "badges"), P(975, 538, 1.06, 0), EIO],
  
  // Scene 5: ATS Resume & Radar
  [T.t4_5, P(960, 540, 1.0, 0), EIO],
  [W(5, "tests"), P(975, 535, 1.06, 0), EOUT],
  [W(5, "rewrites"), P(955, 538, 1.05, 0), EIO],
  
  // Scene 6: Smart Job Board
  [T.t5_6, P(960, 540, 1.0, 0), EIO],
  [W(6, "smart"), P(970, 538, 1.04, 0), EOUT],
  [W(6, "ranked"), P(975, 535, 1.06, 0), EIO],
  
  // Scene 7: Outro Payoff & Lockup
  [T.t6_7, P(960, 540, 1.0, 0), EIO],
  [W(7, "saarthi"), P(960, 540, 0.98, 1.0), EOUT],
  [END, P(960, 540, 0.98, 1.0), LIN]
];

// Anti-tremor sanitizer
function sanitizeCameraTrack(track) {
  const clean = [];
  for (let i = 0; i < track.length; i++) {
    const entry = track[i];
    let [t, p, easing] = entry;
    
    // Rule 1: Drop tilts under 1 degree (except deliberate opening/closing)
    if (Math.abs(p.rot) < 1.0) {
      p.rot = 0;
    }
    
    // Rule 2: If move < 40px with almost no zoom change in < 1.5s, turn into hold
    if (clean.length > 0) {
      const prev = clean[clean.length - 1];
      const dt = t - prev[0];
      const dx = Math.abs(p.x - prev[1].x);
      const dy = Math.abs(p.y - prev[1].y);
      const ds = Math.abs(p.scale - prev[1].scale);
      if (dt < 1.5 && dx < 40 && dy < 40 && ds < 0.04) {
        p.x = prev[1].x;
        p.y = prev[1].y;
        p.scale = prev[1].scale;
      }
    }
    clean.push([t, p, easing]);
  }
  return clean;
}

const cleanCamTrack = sanitizeCameraTrack(rawCamTrack);

// Apply camera animations to #cam-inner and #fg (at 1.4x parallax)
const camInnerEl = document.querySelector("#cam-inner");
const fgEl = document.querySelector("#fg");

const camKeyframes = cleanCamTrack.map(([t, p, easing]) => {
  const tx = (960 - p.x);
  const ty = (540 - p.y);
  return [
    t,
    { transform: `translate(${tx}px, ${ty}px) scale(${p.scale}) rotate(${p.rot}deg)` },
    easing
  ];
});

const fgKeyframes = cleanCamTrack.map(([t, p, easing]) => {
  const tx = (960 - p.x) * 1.15;
  const ty = (540 - p.y) * 1.15;
  return [
    t,
    { transform: `translate(${tx}px, ${ty}px) scale(${1 + (p.scale - 1) * 1.15})` },
    easing
  ];
});

K(camInnerEl, camKeyframes);
K(fgEl, fgKeyframes);

// Camera Motion Blur simulation during fast moves
const camBlurEl = document.querySelector("#camblur");
K(camBlurEl, [
  [0, { opacity: 0 }],
  [T.t0_1, { opacity: 0 }],
  [T.t0_1 + 0.1, { opacity: 0.15 }],
  [T.t0_1 + 0.4, { opacity: 0 }],
  [T.t2_3, { opacity: 0 }],
  [T.t2_3 + 0.1, { opacity: 0.18 }],
  [T.t2_3 + 0.4, { opacity: 0 }],
  [T.t4_5, { opacity: 0 }],
  [T.t4_5 + 0.1, { opacity: 0.2 }],
  [T.t4_5 + 0.4, { opacity: 0 }],
  [END, { opacity: 0 }]
]);

/* =======================================================================
   6. SCENE-SPECIFIC VISUAL BEATS AND WORD CUES
======================================================================= */

// SCENE 0 (S0)
// SVG Logo Stroke Draw
DRAW(document.querySelector("#sc0-svg-circle"), W(0, "hello"), W(0, "welcome"));
DRAW(document.querySelector("#sc0-svg-brain"), W(0, "welcome"), W(0, "saarthi"));
DRAW(document.querySelector("#sc0-svg-synapses"), W(0, "saarthi"), W(0, "companion"));

// Eyebrow and Headline word-by-word reveal
IN(document.querySelector("#sc0-eyebrow"), 0.4, 0.6, { transform: "translateY(-20px)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 });
const sc0Words = split(document.querySelector("#sc0-headline"));
const sc0WordTimes = sc0Words.map((_, i) => W(0, "welcome") + i * 0.16);
KIN(sc0Words, sc0WordTimes);

IN(document.querySelector("#sc0-subtext"), W(0, "personalized"), 0.7, { transform: "translateY(24px)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 });
