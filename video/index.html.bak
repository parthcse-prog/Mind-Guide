   { transform: "rotate(6deg) translateX(80px)", opacity: 0 },
   { transform: "rotate(2.5deg) translateX(0px)", opacity: 0.9 }, EOUT);

IN(document.querySelector("#sc1-shot-front"), W(1, "mentors"), 0.9,
   { transform: "rotate(-6deg) translateY(60px)", opacity: 0 },
   { transform: "rotate(-2deg) translateY(0px)", opacity: 1 }, SPRING);

PULSE(document.querySelector("#sc1-wave-ring"), W(1, "listen"), 1.4);
IN(document.querySelector("#sc1-hl-box"), W(1, "speak"), 0.5, { opacity: 0, transform: "scale(0.9)" }, { opacity: 1, transform: "scale(1.0)" }, SPRING);

