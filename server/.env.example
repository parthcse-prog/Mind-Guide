# Sample .env for Server
# Rename or copy this file to .env and fill in your credentials

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/mind-guide

# Authentication Settings
JWT_SECRET=your_jwt_secret_key_here
JWT_LIFETIME=30d

# OpenAI API Key (Required for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Nodemailer Email Configuration (Optional - for sending report emails)
Email=your_email@gmail.com
PASS=your_email_app_password
USERNAME="Mind Guide"

# AWS S3 Configuration (Optional - for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name

NODE_ENV=development
